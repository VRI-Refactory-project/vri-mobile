# VRI Mobile Environment Configuration Template
# Copy this file to .env and adjust values for your local environment

# Django Backend API URL
# Options based on test environment:
# - Web Preview / iOS Simulator: http://localhost:8000
# - Android Emulator: http://10.0.2.2:8000
# - Physical Phone (Expo Go): http://<your-computer-ip>:8000
EXPO_PUBLIC_API_URL=http://localhost:8000